# Copy this file to .env and fill in a real key. .env is gitignored - never
# commit a real API key.

# Required for Milestone 7 (real LLM calls). Without this set, every agent
# falls back to its heuristic implementation - MogBot still runs, just
# without the LLM.
ANTHROPIC_API_KEY=

# Optional overrides.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=2048

# Milestone 8 guardrails.
# MOGBOT_SESSION_RATE_LIMIT=10 per hour
# MOGBOT_ANSWER_RATE_LIMIT=60 per hour
# MOGBOT_MAX_INPUT_CHARS=20000
# MOGBOT_MAX_ANSWER_CHARS=5000

# Milestone 9 persistence. Point these at a mounted persistent volume in
# production so data survives a redeploy on an ephemeral filesystem.
# MOGBOT_SESSIONS_DB=data/sessions.db
# MOGBOT_VECTOR_DB_DIR=data/vector_db
