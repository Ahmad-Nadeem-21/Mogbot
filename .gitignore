# Python
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime data that should not be committed
data/vector_db/*
!data/vector_db/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/private/*
data/sessions.db
data/test_tmp/
logs/
traces/

# User/private artifacts
*.resume.pdf
*.transcript.json
*.local.json

# Terraform (terraform/README.md - state can contain the generated SSH
# private key in plaintext; never commit it)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
!terraform/.terraform.lock.hcl
